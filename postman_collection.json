{
  "info": {
    "name": "Fuel Route API",
    "description": "Cheapest fuel stops along a US driving route. Start the server with `python manage.py runserver`, then run these top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "1. Coast to coast (GET)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/route/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        },
        "description": "New York to Los Angeles: ~2,800 miles, several fuel stops, one routing call, zero geocoding calls. Open `map.url` from the response in a browser to see it drawn. Send it twice: the second answer comes from cache in a few ms."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const plan = pm.response.json();",
              "pm.test('at most one routing API call', () => pm.expect(plan.meta.external_api_calls.routing).to.be.at.most(1));",
              "pm.test('stop costs add up to the total', () => {",
              "  const sum = plan.fuel_stops.reduce((total, stop) => total + stop.cost, 0);",
              "  pm.expect(sum).to.be.closeTo(plan.summary.total_fuel_cost, 0.05);",
              "});",
              "pm.test('never buys more than the tank holds', () => plan.fuel_stops.forEach(stop =>",
              "  pm.expect(stop.fuel_on_arrival_gallons + stop.gallons_purchased).to.be.at.most(plan.vehicle.tank_gallons + 0.01)));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. JSON body (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/route/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ]
        },
        "description": "Same endpoint with a JSON body. Note stop 1: just enough fuel to reach the much cheaper stop 2.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Denver, CO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const plan = pm.response.json();",
              "pm.test('at most one routing API call', () => pm.expect(plan.meta.external_api_calls.routing).to.be.at.most(1));",
              "pm.test('stop costs add up to the total', () => {",
              "  const sum = plan.fuel_stops.reduce((total, stop) => total + stop.cost, 0);",
              "  pm.expect(sum).to.be.closeTo(plan.summary.total_fuel_cost, 0.05);",
              "});",
              "pm.test('never buys more than the tank holds', () => plan.fuel_stops.forEach(stop =>",
              "  pm.expect(stop.fuel_on_arrival_gallons + stop.gallons_purchased).to.be.at.most(plan.vehicle.tank_gallons + 0.01)));"
            ]
          }
        }
      ]
    },
